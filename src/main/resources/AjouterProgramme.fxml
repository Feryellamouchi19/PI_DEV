<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="650.0" prefWidth="900.0"
           stylesheets="@/css/style.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.AjouterProgrammeController">

    <ImageView fitHeight="650.0" fitWidth="900.0" preserveRatio="false">
        <image>
            <Image url="@/images/space_bg.jpg"/>
        </image>
    </ImageView>

    <Pane styleClass="bg-overlay"/>

    <BorderPane>
        <padding>
            <Insets top="26" right="26" bottom="26" left="26"/>
        </padding>

        <center>
            <VBox alignment="TOP_CENTER" spacing="16">

                <HBox alignment="CENTER" spacing="16">
                    <ImageView fitHeight="78" fitWidth="78" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png"/>
                        </image>
                    </ImageView>
                    <Label text="Ajouter Programme" styleClass="title"/>
                </HBox>

                <Label fx:id="lblEventInfo" text="—" styleClass="subtitle"/>

                <TextField fx:id="txtTitre" promptText="Titre du programme" maxWidth="620"/>

                <Label text="Date début" styleClass="subtitle"/>

                <HBox spacing="10" alignment="CENTER">
                    <DatePicker fx:id="dpDebut" prefWidth="220"/>
                    <Spinner fx:id="spDebutH" prefWidth="85"/>
                    <Spinner fx:id="spDebutM" prefWidth="85"/>
                </HBox>

                <Label text="Date fin" styleClass="subtitle"/>

                <HBox spacing="10" alignment="CENTER">
                    <DatePicker fx:id="dpFin" prefWidth="220"/>
                    <Spinner fx:id="spFinH" prefWidth="85"/>
                    <Spinner fx:id="spFinM" prefWidth="85"/>
                </HBox>

                <HBox spacing="16" alignment="CENTER">
                    <!-- ✅ IMPORTANT -->
                    <Button text="Ajouter" styleClass="btn-primary" onAction="#onAjouterProgramme"/>
                    <Button text="Retour" styleClass="btn-secondary" onAction="#onRetour"/>
                </HBox>

                <Label fx:id="lblMessage" text="" styleClass="subtitle"/>

            </VBox>
        </center>

    </BorderPane>
</StackPane>