<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root"
           prefHeight="650.0"
           prefWidth="900.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ListeEvenementsController"
           styleClass="app-root">

    <!-- Background image -->
    <ImageView fx:id="bgImage"
               fitHeight="650.0"
               fitWidth="900.0"
               preserveRatio="false"/>

    <!-- Overlay -->
    <Pane styleClass="bg-overlay"/>

    <!-- CONTENT (NO BIG SQUARE) -->
    <BorderPane>
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- ================= TOP ================= -->
        <top>
            <VBox spacing="18">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT"
                      spacing="16"
                      styleClass="header-card">

                    <ImageView fx:id="imgLogo"
                               fitHeight="58"
                               fitWidth="58"
                               preserveRatio="true"/>

                    <VBox spacing="3">
                        <Label text="Liste des Événements"
                               styleClass="title"/>
                        <Label fx:id="lblMsg"
                               styleClass="subtitle"/>
                    </VBox>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <ToggleButton fx:id="btnTheme"
                                  text="🌙"
                                  onAction="#toggleTheme"
                                  styleClass="btn-secondary"/>

                    <Label text="Mode:"
                           styleClass="chip"/>

                    <ChoiceBox fx:id="cbRole"
                               prefWidth="130"/>
                </HBox>

                <!-- Search -->
                <HBox spacing="12">
                    <TextField fx:id="txtSearch"
                               promptText="Rechercher par titre / lieu / description..."
                               HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnRechercher"
                            text="Rechercher"
                            styleClass="btn-primary"
                            onAction="#onSearch"/>

                    <Button fx:id="btnReset"
                            text="Reset"
                            styleClass="btn-secondary"
                            onAction="#onReset"/>
                </HBox>

                <!-- Filters -->
                <HBox spacing="12"
                      styleClass="panel">
                    <ComboBox fx:id="cbType" prefWidth="160"/>
                    <ComboBox fx:id="cbSort" prefWidth="160"/>
                    <DatePicker fx:id="dpFrom" prefWidth="160"/>
                    <DatePicker fx:id="dpTo" prefWidth="160"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnFiltrer"
                            text="Filtrer"
                            styleClass="btn-primary"
                            onAction="#onFiltrer"/>
                </HBox>

            </VBox>
        </top>

        <!-- ================= CENTER ================= -->
        <center>
            <VBox spacing="10">
                <Label text="Résultats"
                       styleClass="subtitle"/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="glass-scroll">

                    <content>
                        <VBox spacing="18">
                            <FlowPane fx:id="flowEvents"
                                      hgap="20"
                                      vgap="20"
                                      prefWrapLength="820"/>

                            <VBox fx:id="boxReco"
                                  spacing="10">
                                <Label fx:id="lblReco"
                                       text="⭐ Recommandés pour vous"
                                       styleClass="subtitle"/>

                                <FlowPane fx:id="flowRecommended"
                                          hgap="20"
                                          vgap="20"
                                          prefWrapLength="820"/>
                            </VBox>
                        </VBox>
                    </content>

                </ScrollPane>
            </VBox>
        </center>

        <!-- ================= BOTTOM ================= -->
        <bottom>
            <HBox alignment="CENTER_RIGHT"
                  spacing="14"
                  styleClass="dock-bar">
                <Button fx:id="btnSupprimer"
                        text="Supprimer"
                        styleClass="btn-danger"
                        onAction="#onSupprimer"/>

                <Button fx:id="btnAjouterBottom"
                        text="Ajouter Événement"
                        styleClass="btn-primary"
                        onAction="#onGoAjouter"/>
            </HBox>
        </bottom>

    </BorderPane>

</StackPane>