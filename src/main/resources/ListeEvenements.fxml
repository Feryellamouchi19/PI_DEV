<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="650.0" prefWidth="900.0"
           stylesheets="@/css/style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.ListeEvenementsController">

    <!-- Background image -->
    <ImageView fx:id="bgImage" fitHeight="650.0" fitWidth="900.0" preserveRatio="false">
        <image>
            <Image url="@/images/space_bg.jpg" />
        </image>
    </ImageView>

    <!-- Dark overlay -->
    <Pane styleClass="bg-overlay" />

    <!-- Main content -->
    <BorderPane>
        <padding>
            <Insets bottom="26" left="26" right="26" top="26" />
        </padding>

        <!-- TOP -->
        <top>
            <VBox spacing="14">

                <!-- Header glass -->
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header-card">

                    <ImageView fitHeight="58" fitWidth="58" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png" />
                        </image>
                    </ImageView>

                    <VBox spacing="3">
                        <Label styleClass="title" text="Liste des Événements" />
                        <Label fx:id="lblMsg" styleClass="subtitle" text="" />
                    </VBox>

                    <Pane HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Search bar -->
                <HBox alignment="CENTER_LEFT" spacing="12">

                    <TextField fx:id="txtSearch"
                               promptText="Rechercher par titre / lieu / description..."
                               HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnRechercher"
                            styleClass="btn-primary"
                            text="Rechercher"
                            onAction="#onSearch"/>

                    <Button fx:id="btnReset"
                            styleClass="btn-secondary"
                            text="Reset"
                            onAction="#onReset"/>
                </HBox>

                <!-- Filters -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel">

                    <ComboBox fx:id="cbType" prefWidth="170.0" promptText="Type" />
                    <ComboBox fx:id="cbSort" prefWidth="170.0" promptText="Trier par" />
                    <DatePicker fx:id="dpFrom" prefWidth="170.0" promptText="Du" />
                    <DatePicker fx:id="dpTo" prefWidth="170.0" promptText="Au" />

                    <Pane HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnFiltrer"
                            styleClass="btn-primary"
                            text="Filtrer"
                            onAction="#onFiltrer"/>
                </HBox>

            </VBox>
        </top>

        <!-- CENTER -->
        <center>
            <VBox spacing="10">
                <padding>
                    <Insets bottom="0" left="0" right="0" top="18" />
                </padding>

                <ScrollPane fitToWidth="true" prefViewportHeight="420.0" styleClass="glass-scroll">
                    <content>
                        <FlowPane fx:id="flowEvents" hgap="18" prefWrapLength="820" vgap="18">
                            <padding>
                                <Insets bottom="10" left="10" right="10" top="10" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </VBox>
        </center>

        <!-- BOTTOM -->
        <bottom>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <padding>
                    <Insets bottom="0" left="0" right="0" top="18" />
                </padding>

                <Button fx:id="btnSupprimer"
                        styleClass="btn-danger"
                        text="Supprimer"
                        onAction="#onSupprimer"/>

                <Button fx:id="btnAjouterBottom"
                        styleClass="btn-primary"
                        text="Ajouter Événement"
                        onAction="#onGoAjouter"/>
            </HBox>
        </bottom>

    </BorderPane>
</StackPane>